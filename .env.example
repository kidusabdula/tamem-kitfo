# Copy to .env.local and fill in. Never commit .env.local.
#
# The site deliberately runs without any of these: the menu, address and
# opening hours fall back to bundled fixtures so a misconfigured deployment
# still shows a working restaurant page. Ordering and the CMS need real keys.

# ---------------------------------------------------------------- Supabase
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Public form submissions write through this because the anon
# role has no INSERT policies anywhere. It bypasses RLS entirely — it must
# never be exposed to the browser and must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------- Telegram
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# The group the order cards are posted to. Add the bot to the group, send a
# message, then read the chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Group ids are negative, e.g. -1001234567890
TELEGRAM_CHAT_ID=
# Any long random string. Telegram echoes it back on every webhook call and
# the handler rejects anything without it — otherwise anyone who guessed the
# URL could cancel every order in the restaurant.
TELEGRAM_WEBHOOK_SECRET=

# After deploying, register the webhook once:
#   curl -F "url=https://<domain>/api/telegram/webhook" \
#        -F "secret_token=$TELEGRAM_WEBHOOK_SECRET" \
#        https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook

# --------------------------------------------------------------- WhatsApp
# International format, digits only. Used for the fallback deep link shown
# when a form submission fails — which matters on Ethiopian mobile data.
NEXT_PUBLIC_WHATSAPP_NUMBER=251911318754

# ------------------------------------------------------------------ Other
# Used for canonical URLs, hreflang and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://tamemkitfo.com

# Salt for the rate limiter's IP hashing. Raw IPs are never stored. Change it
# and existing rate-limit windows reset, which is harmless.
RATE_LIMIT_SALT=
